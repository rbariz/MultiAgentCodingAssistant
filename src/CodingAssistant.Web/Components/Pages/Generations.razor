@page "/generations"

@implements IAsyncDisposable

@rendermode InteractiveServer


@using CodingAssistant.Contracts.Generations
@using CodingAssistant.Contracts.GitHub
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<h1>Multi-Agent Coding Assistant</h1>

<div class="card">
    <label>Prompt</label>
    <textarea @bind="UserPrompt" rows="5"></textarea>

    <label>Target Stack</label>
    <input @bind="TargetStack" />


    <button type="button" @onclick="CreateGeneration" disabled="@IsLoading">
        @(IsLoading ? "Generating..." : "Generate Project")
    </button>
</div>

@if (Generation is not null)
{
    <hr />

    <h2>@(string.IsNullOrWhiteSpace(Generation.ProjectName) ? "Generation in progress" : Generation.ProjectName)</h2>

    <p>Status: <strong>@Generation.Status</strong></p>


    @if (Generation?.Status == "Completed")
    {
        <div class="github-panel">

            <h3>Publish to GitHub</h3>

            <input type="password"
                   placeholder="GitHub Personal Access Token"
                   @bind="GitHubToken" />

            <button @onclick="PublishToGitHub"
                    disabled="@IsPublishingToGitHub">

                @(IsPublishingToGitHub
                        ? "Publishing..."
                        : "Publish to GitHub")
    </button>

    @if (!string.IsNullOrWhiteSpace(GitHubRepositoryUrl))
            {
                <p>
                    Repository:
                    <a href="@GitHubRepositoryUrl" target="_blank">
                        @GitHubRepositoryUrl
                    </a>
                </p>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Generation.ErrorMessage))
    {
        <div class="error-box">
            @Generation.ErrorMessage
        </div>
    }


    <h3>Agent Timeline</h3>

    <div class="timeline-grid">
        @foreach (var step in _liveSteps)
        {
            <div class="timeline-card @StepCss(step.Status)">
                <div class="timeline-title">@step.Name</div>
                <div class="timeline-status">@step.Status</div>
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <p class="muted">Generation running with Ollama...</p>
    }

    @if (Generation.Status == "Completed" && Generation.Files.Count > 0)
    {
        <a class="primary-link" href="@($"{ApiBaseUrl}/api/generations/{Generation.Id}/export")" target="_blank">
            Download ZIP
        </a>
    }

    <h3>Steps</h3>

    <ul>
        @foreach (var step in Generation.Steps.OrderBy(x => x.Order))
        {
            <li>
                <strong>@step.AgentRole</strong> —
                @step.Name —
                @step.Status
            </li>
        }
    </ul>


    <h3>Realtime Logs</h3>

    <div class="logs-panel">
        @foreach (var log in _liveLogs)
        {
            <div class="log-line">@log</div>
        }
    </div>


    @if (_streamingFileContent.Count > 0)
    {
        <h3>Live AI Streaming</h3>

        @foreach (var item in _streamingFileContent)
        {
            <details open>
                <summary>@item.Key</summary>
                <pre>@item.Value</pre>
            </details>
        }
    }

    @if (_liveFiles.Count > 0)
    {
        <h3>Live Generated Files</h3>

        <div class="live-files">
            @foreach (var file in _liveFiles)
            {
                <div class="live-file-row">
                    <span>@file.Path</span>
                    <strong>@file.Status</strong>
                </div>
            }
        </div>
    }


    <h3>Files</h3>

    @foreach (var file in Generation.Files.OrderBy(x => x.Order))
    {
        <details>
            <summary>@file.RelativePath</summary>
            <pre>@file.Content</pre>
        </details>
    }
}
@code {
    public string ApiBaseUrl = string.Empty;

    public string UserPrompt { get; set; } =
        "Build a calculator web app with add, subtract, multiply and divide buttons";

    public string TargetStack { get; set; } = "html-css-js";

    public bool IsLoading { get; set; }

    public ProjectGenerationDto? Generation { get; set; }

    public HubConnection? _hubConnection;

    public readonly Dictionary<string, string> _streamingFileContent = [];

    public readonly List<string> _liveLogs = [];

    public readonly List<LiveStepItem> _liveSteps =
[
    new("Planner", "Pending"),
    new("Architect", "Pending"),
    new("Developer", "Pending"),
    new("Reviewer", "Pending")
    ];

    public readonly List<LiveFileItem> _liveFiles = [];

    public string GitHubToken { get; set; } = string.Empty;
    public string? GitHubRepositoryUrl { get; set; }
    public bool IsPublishingToGitHub { get; set; }
    public string? GitHubPublishError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ApiBaseUrl = HttpClientFactory
            .CreateClient("Api")
            .BaseAddress!
            .ToString()
            .TrimEnd('/');

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{ApiBaseUrl}/hubs/generations")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<object>("GenerationStarted", payload =>
        {
            _liveLogs.Add("Generation started");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<object>("AgentMessage", payload =>
        {
            _liveLogs.Add(payload?.ToString() ?? "Agent message");
            InvokeAsync(StateHasChanged);
        });


        _hubConnection.On<object>("GenerationCompleted", async payload =>
{
    _liveLogs.Add("Generation completed");

    if (Generation is not null)
    {
        var client = HttpClientFactory.CreateClient("Api");

        var refreshed = await client.GetFromJsonAsync<ProjectGenerationDto>(
            $"/api/generations/{Generation.Id}");

        if (refreshed is not null)
        {
            Generation = refreshed;
        }
    }

    IsLoading = false;

    await InvokeAsync(StateHasChanged);
});
        _hubConnection.On<object>("GenerationFailed", async payload =>
{
    _liveLogs.Add(payload?.ToString() ?? "Generation failed");

    if (Generation is not null)
    {
        var client = HttpClientFactory.CreateClient("Api");

        var refreshed = await client.GetFromJsonAsync<ProjectGenerationDto>(
            $"/api/generations/{Generation.Id}");

        if (refreshed is not null)
        {
            Generation = refreshed;
        }
    }

    IsLoading = false;

    await InvokeAsync(StateHasChanged);
});


        _hubConnection.On<StepEvent>("StepStarted", payload =>
        {
            UpdateStep(payload.Step, "Running");
            _liveLogs.Add($"{payload.Step} started");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<StepEvent>("StepCompleted", payload =>
        {
            UpdateStep(payload.Step, "Completed");
            _liveLogs.Add($"{payload.Step} completed");
            InvokeAsync(StateHasChanged);
        });



        _hubConnection.On<FileEvent>("FileGenerationStarted", payload =>
        {
            var existing = _liveFiles.FirstOrDefault(x => x.Path == payload.File);

            if (existing is null)
            {
                _liveFiles.Add(new LiveFileItem(payload.File, "Generating"));
            }
            else
            {
                existing.Status = "Generating";
            }

            _liveLogs.Add($"Generating file: {payload.File}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<FileEvent>("FileGenerated", payload =>
        {
            var existing = _liveFiles.FirstOrDefault(x => x.Path == payload.File);

            if (existing is null)
            {
                _liveFiles.Add(new LiveFileItem(payload.File, "Completed"));
            }
            else
            {
                existing.Status = "Completed";
            }

            _liveLogs.Add($"File generated: {payload.File}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<FileEvent>("FileContentStreamingStarted", payload =>
{
    _streamingFileContent[payload.File] = string.Empty;
    _liveLogs.Add($"Streaming started: {payload.File}");
    InvokeAsync(StateHasChanged);
});

        _hubConnection.On<FileDeltaEvent>("FileContentDelta", payload =>
        {
            if (!_streamingFileContent.ContainsKey(payload.File))
                _streamingFileContent[payload.File] = string.Empty;

            _streamingFileContent[payload.File] += payload.Delta;

            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<FileEvent>("FileContentStreamingCompleted", payload =>
        {
            _liveLogs.Add($"Streaming completed: {payload.File}");
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    public async Task CreateGeneration()
    {
        IsLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");

            var createResponse = await client.PostAsJsonAsync(
                "/api/generations",
                new CreateGenerationRequest
                {
                    UserPrompt = UserPrompt,
                    TargetStack = TargetStack
                });

            createResponse.EnsureSuccessStatusCode();

            Generation = await createResponse.Content
                         .ReadFromJsonAsync<ProjectGenerationDto>();

            if (Generation is null)
                return;

            _liveLogs.Clear();
            _liveFiles.Clear();
            _streamingFileContent.Clear();

            foreach (var step in _liveSteps)
            {
                step.Status = "Pending";
            }
            
            await _hubConnection!.InvokeAsync(
                "JoinGeneration",
                Generation.Id);


            await InvokeAsync(StateHasChanged);

            var runResponse = await client.PostAsync(
                $"/api/generations/{Generation.Id}/run",
                content: null);

            runResponse.EnsureSuccessStatusCode();

            Generation = await client.GetFromJsonAsync<ProjectGenerationDto>(
                $"/api/generations/{Generation.Id}");

            await InvokeAsync(StateHasChanged);

            await PollGenerationUntilDone(Generation!.Id);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task PollGenerationUntilDone(Guid id)
    {
        var client = HttpClientFactory.CreateClient("Api");

        for (var i = 0; i < 120; i++)
        {
            await Task.Delay(2000);

            var refreshed = await client.GetFromJsonAsync<ProjectGenerationDto>(
                $"/api/generations/{id}");

            if (refreshed is not null)
            {
                Generation = refreshed;
            }

            await InvokeAsync(StateHasChanged);

            if (Generation?.Status is "Completed" or "Failed" or "Cancelled")
                return;
        }
    }

    public void UpdateStep(string name, string status)
    {
        var step = _liveSteps.FirstOrDefault(x =>
            x.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

        if (step is not null)
        {
            step.Status = status;
        }
    }

    public static string StepCss(string status)
    {
        return status switch
        {
            "Completed" => "is-completed",
            "Running" => "is-running",
            "Failed" => "is-failed",
            _ => "is-pending"
        };
    }

    public async Task PublishToGitHub()
    {
        GitHubPublishError = null;
        if (Generation is null)
            return;

        IsPublishingToGitHub = true;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");

            var response = await client.PostAsJsonAsync(
                "/api/github/publish",
                new
                {
                    GenerationId = Generation.Id,
                    RepositoryName = Generation.ProjectName,
                    IsPrivate = true,
                    GitHubToken
                });

            response.EnsureSuccessStatusCode();

            var result = await response.Content
                .ReadFromJsonAsync<PublishToGitHubResponse>();

            GitHubRepositoryUrl = result?.RepositoryUrl;
        }
        catch (Exception ex)
        {
            GitHubPublishError = ex.Message;
        }
        finally
        {
            IsPublishingToGitHub = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    

    

    
    
}