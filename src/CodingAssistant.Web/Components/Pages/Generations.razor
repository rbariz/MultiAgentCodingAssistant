@page "/generations"

@implements IAsyncDisposable

@rendermode InteractiveServer

@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<h1>Multi-Agent Coding Assistant</h1>

<div class="card">
    <label>Prompt</label>
    <textarea @bind="UserPrompt" rows="5"></textarea>

    <label>Target Stack</label>
    <input @bind="TargetStack" />


    <button type="button" @onclick="CreateGeneration" disabled="@IsLoading">
        @(IsLoading ? "Generating..." : "Generate Project")
    </button>
</div>

@if (Generation is not null)
{
    <hr />

    <h2>@(string.IsNullOrWhiteSpace(Generation.ProjectName) ? "Generation in progress" : Generation.ProjectName)</h2>

    <p>Status: <strong>@Generation.Status</strong></p>

    @if (!string.IsNullOrWhiteSpace(Generation.ErrorMessage))
    {
        <div class="error-box">
            @Generation.ErrorMessage
        </div>
    }


    <h3>Agent Timeline</h3>

    <div class="timeline-grid">
        @foreach (var step in _liveSteps)
        {
            <div class="timeline-card @StepCss(step.Status)">
                <div class="timeline-title">@step.Name</div>
                <div class="timeline-status">@step.Status</div>
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <p class="muted">Generation running with Ollama...</p>
    }

    @if (Generation.Status == "Completed" && Generation.Files.Count > 0)
    {
        <a class="primary-link" href="@($"{ApiBaseUrl}/api/generations/{Generation.Id}/export")" target="_blank">
            Download ZIP
        </a>
    }

    <h3>Steps</h3>

    <ul>
        @foreach (var step in Generation.Steps.OrderBy(x => x.Order))
        {
            <li>
                <strong>@step.AgentRole</strong> —
                @step.Name —
                @step.Status
            </li>
        }
    </ul>


    <h3>Realtime Logs</h3>

    <div class="logs-panel">
        @foreach (var log in _liveLogs)
        {
            <div class="log-line">@log</div>
        }
    </div>

    @if (_liveFiles.Count > 0)
    {
        <h3>Live Generated Files</h3>

        <div class="live-files">
            @foreach (var file in _liveFiles)
            {
                <div class="live-file-row">
                    <span>@file.Path</span>
                    <strong>@file.Status</strong>
                </div>
            }
        </div>
    }


    <h3>Files</h3>

    @foreach (var file in Generation.Files.OrderBy(x => x.Order))
    {
        <details>
            <summary>@file.RelativePath</summary>
            <pre>@file.Content</pre>
        </details>
    }
}
@code {
    private string ApiBaseUrl = string.Empty;

    private string UserPrompt { get; set; } =
        "Build a calculator web app with add, subtract, multiply and divide buttons";

    private string TargetStack { get; set; } = "html-css-js";

    private bool IsLoading { get; set; }

    private ProjectGenerationDto? Generation { get; set; }

    private HubConnection? _hubConnection;

    private readonly List<string> _liveLogs = [];

    private readonly List<LiveStepItem> _liveSteps =
[
    new("Planner", "Pending"),
    new("Architect", "Pending"),
    new("Developer", "Pending"),
    new("Reviewer", "Pending")
    ];

    private readonly List<LiveFileItem> _liveFiles = [];

    protected override async Task OnInitializedAsync()
    {
        ApiBaseUrl = HttpClientFactory
            .CreateClient("Api")
            .BaseAddress!
            .ToString()
            .TrimEnd('/');

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{ApiBaseUrl}/hubs/generations")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<object>("GenerationStarted", payload =>
        {
            _liveLogs.Add("Generation started");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<object>("AgentMessage", payload =>
        {
            _liveLogs.Add(payload?.ToString() ?? "Agent message");
            InvokeAsync(StateHasChanged);
        });


        _hubConnection.On<object>("GenerationCompleted", payload =>
        {
            _liveLogs.Add("Generation completed");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<object>("GenerationFailed", payload =>
        {
            _liveLogs.Add(payload?.ToString() ?? "Generation failed");
            InvokeAsync(StateHasChanged);
        });


        _hubConnection.On<StepEvent>("StepStarted", payload =>
        {
            UpdateStep(payload.Step, "Running");
            _liveLogs.Add($"{payload.Step} started");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<StepEvent>("StepCompleted", payload =>
        {
            UpdateStep(payload.Step, "Completed");
            _liveLogs.Add($"{payload.Step} completed");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<FileEvent>("FileGenerationStarted", payload =>
        {
            var existing = _liveFiles.FirstOrDefault(x => x.Path == payload.File);

            if (existing is null)
            {
                _liveFiles.Add(new LiveFileItem(payload.File, "Generating"));
            }
            else
            {
                existing.Status = "Generating";
            }

            _liveLogs.Add($"Generating file: {payload.File}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<FileEvent>("FileGenerated", payload =>
        {
            var existing = _liveFiles.FirstOrDefault(x => x.Path == payload.File);

            if (existing is null)
            {
                _liveFiles.Add(new LiveFileItem(payload.File, "Completed"));
            }
            else
            {
                existing.Status = "Completed";
            }

            _liveLogs.Add($"File generated: {payload.File}");
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    private async Task CreateGeneration()
    {
        IsLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");

            var createResponse = await client.PostAsJsonAsync(
                "/api/generations",
                new CreateGenerationRequest
                {
                    UserPrompt = UserPrompt,
                    TargetStack = TargetStack
                });

            createResponse.EnsureSuccessStatusCode();

            Generation = await createResponse.Content
                         .ReadFromJsonAsync<ProjectGenerationDto>();

            if (Generation is null)
                return;

            _liveLogs.Clear();
            _liveFiles.Clear();

            foreach (var step in _liveSteps)
            {
                step.Status = "Pending";
            }
            
            await _hubConnection!.InvokeAsync(
                "JoinGeneration",
                Generation.Id);


            await InvokeAsync(StateHasChanged);

            var runResponse = await client.PostAsync(
                $"/api/generations/{Generation.Id}/run",
                content: null);

            runResponse.EnsureSuccessStatusCode();

            Generation = await client.GetFromJsonAsync<ProjectGenerationDto>(
                $"/api/generations/{Generation.Id}");

            await InvokeAsync(StateHasChanged);

            await PollGenerationUntilDone(Generation!.Id);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollGenerationUntilDone(Guid id)
    {
        var client = HttpClientFactory.CreateClient("Api");

        for (var i = 0; i < 120; i++)
        {
            await Task.Delay(2000);

            var refreshed = await client.GetFromJsonAsync<ProjectGenerationDto>(
                $"/api/generations/{id}");

            if (refreshed is not null)
            {
                Generation = refreshed;
            }

            await InvokeAsync(StateHasChanged);

            if (Generation?.Status is "Completed" or "Failed" or "Cancelled")
                return;
        }
    }

    private void UpdateStep(string name, string status)
    {
        var step = _liveSteps.FirstOrDefault(x =>
            x.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

        if (step is not null)
        {
            step.Status = status;
        }
    }

    private static string StepCss(string status)
    {
        return status switch
        {
            "Completed" => "is-completed",
            "Running" => "is-running",
            "Failed" => "is-failed",
            _ => "is-pending"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private sealed class CreateGenerationRequest
    {
        public string UserPrompt { get; set; } = string.Empty;
        public string? TargetStack { get; set; }
    }

    private sealed class ProjectGenerationDto
    {
        public Guid Id { get; set; }
        public string UserPrompt { get; set; } = string.Empty;
        public string? ProjectName { get; set; }
        public string? TargetStack { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? ErrorMessage { get; set; }
        public List<GeneratedFileDto> Files { get; set; } = [];
        public List<GenerationStepDto> Steps { get; set; } = [];
    }

    private sealed class GeneratedFileDto
    {
        public string RelativePath { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public int Order { get; set; }
    }

    private sealed class GenerationStepDto
    {
        public string AgentRole { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int Order { get; set; }
    }

    private sealed record LiveStepItem(string Name, string Status)
    {
        public string Name { get; set; } = Name;
        public string Status { get; set; } = Status;
    }

    private sealed record LiveFileItem(string Path, string Status)
    {
        public string Path { get; set; } = Path;
        public string Status { get; set; } = Status;
    }

    private sealed class StepEvent
    {
        public string Step { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private sealed class FileEvent
    {
        public string File { get; set; } = string.Empty;
    }
}